# ==============================================================
# SmartHome OS - Production Environment Variables
# Copy this file to .env and fill in your values
# ==============================================================

# PostgreSQL Database Configuration
DB_USER=postgres
DB_PASSWORD=change_this_to_a_strong_database_password
DB_NAME=smarthome_db

# Security & Authentication
JWT_SECRET=generate_a_random_64_character_string_here

# Domain & Public URLs
DOMAIN_NAME=yourdomain.com
NEXT_PUBLIC_API_URL=/api

# CORS Configuration (optional, default allows all in proxy mode)
CORS_ORIGIN=*

# SMTP Notification Settings (for Leads & Job Applications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
ADMIN_EMAIL=inquiries@yourdomain.com
